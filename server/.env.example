# Runtime
NODE_ENV=development
PORT=5000
PUBLIC_BASE_URL=http://localhost:5000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/store.db

# Security - REQUIRED for production
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
COOKIE_SECURE=false

# Bootstrap admin - change before production
ADMIN_NAME=مدیر اسپرت جاوید
ADMIN_EMAIL=admin@sportcarjavid.local
ADMIN_PASSWORD=Admin@123456

# Payment
# true = local test payment succeeds immediately without contacting ZarinPal
IS_SANDBOX_MODE=true
# Fill only when your gateway is approved and IS_SANDBOX_MODE=false
ZARINPAL_MERCHANT_ID=
# Optional. If empty, PUBLIC_BASE_URL + /api/payments/zarinpal/callback is used.
ZARINPAL_CALLBACK_URL=
