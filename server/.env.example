# Runtime
NODE_ENV=development
PORT=5000
PUBLIC_BASE_URL=http://localhost:5000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/store.db
UPLOAD_DIR=./data/uploads

# Security - REQUIRED for production
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
COOKIE_SECURE=false

# Bootstrap admin - change before production
ADMIN_NAME=مدیر اسپرت جاوید
ADMIN_EMAIL=admin@sportcarjavid.local
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Payment
# true = local test payment succeeds immediately without contacting ZarinPal
IS_SANDBOX_MODE=true
ZARINPAL_MERCHANT_ID=
# Optional. If empty, PUBLIC_BASE_URL + /api/payments/zarinpal/callback is used.
ZARINPAL_CALLBACK_URL=

# SMS.ir
# IMPORTANT: SMS has its own switch. Payment sandbox does NOT sandbox SMS.ir calls.
SMS_ENABLED=false
# true = exercise all SMS flows without contacting SMS.ir
SMS_DRY_RUN=true
SMS_API_KEY=YOUR_SMS_IR_API_KEY
SMS_LINE_NUMBER=YOUR_SMS_IR_LINE_NUMBER
SMS_VERIFY_TEMPLATE_ID=YOUR_VERIFY_TEMPLATE_ID
# Optional: use a dedicated password-reset template; falls back to VERIFY template when empty.
SMS_RESET_TEMPLATE_ID=
SMS_BASE_URL=https://api.sms.ir/v1
# Comma-separated mobile numbers that receive new-order/payment alerts.
SMS_ADMIN_MOBILES=
# Security / UX tuning
SMS_OTP_TTL_SECONDS=120
SMS_RESEND_COOLDOWN_SECONDS=60
SMS_MAX_OTP_ATTEMPTS=5
