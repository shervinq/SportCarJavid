# Runtime
NODE_ENV=development
PORT=5000
PUBLIC_BASE_URL=http://localhost:5000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/store.db
UPLOAD_DIR=./data/uploads

# Security - REQUIRED for production
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
COOKIE_SECURE=false

# Bootstrap admin - change before production
ADMIN_NAME=مدیر اسپرت جاوید
ADMIN_EMAIL=admin@sportcarjavid.local
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Payment
# true = local payment bypass for development/testing only
IS_SANDBOX_MODE=true
ZARINPAL_MERCHANT_ID=
ZARINPAL_CURRENCY=IRT
# Optional; defaults to PUBLIC_BASE_URL + /api/payments/zarinpal/callback
ZARINPAL_CALLBACK_URL=

# SMS.ir
SMS_ENABLED=false
# true = exercise SMS flows without contacting SMS.ir
SMS_DRY_RUN=true
SMS_API_KEY=YOUR_SMS_IR_API_KEY
SMS_LINE_NUMBER=YOUR_SMS_IR_LINE_NUMBER
SMS_VERIFY_TEMPLATE_ID=YOUR_VERIFY_TEMPLATE_ID
# Optional; falls back to VERIFY template when empty
SMS_RESET_TEMPLATE_ID=
SMS_BASE_URL=https://api.sms.ir/v1
# Comma-separated mobile numbers for new-order/payment alerts
SMS_ADMIN_MOBILES=
SMS_OTP_TTL_SECONDS=120
SMS_RESEND_COOLDOWN_SECONDS=60
SMS_MAX_OTP_ATTEMPTS=5

# Store operations (optional overrides)
FREE_SHIPPING_THRESHOLD=5000000
TEHRAN_SHIPPING_COST=180000
DEFAULT_SHIPPING_COST=220000
PENDING_ORDER_EXPIRY_MINUTES=30
